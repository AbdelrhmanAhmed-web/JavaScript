body{
    font-family: Arial, Helvetica, sans-serif;
    background-color:  #1e222b;
    padding: 20px;
    color :#d1d5db;
}
.header{
    text-align: center;
    margin-bottom: 20px;
}
.title{
    font-style: italic;
    font-weight: bolder;
}
.input_area{
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 12px;
    height: 100px;
}
.add{
    background-color: rgb(26, 159, 26);
    color: white;
    width: 60px;
    cursor: pointer;
    border-radius: 6px;
}
.add:hover{
    background-color: rgb(8, 130, 8);
}
.clear{
    background-color: red;
    color:white;
    width: 60px;
    cursor: pointer;
    border-radius: 6px;
}
.clear:hover{
    background-color: rgb(157, 5, 5);
}
.input{
    border-radius: 6px;
    width: 300px;
    font-size: 16px;
    border: 2px solid #ccc;
    outline: none;
}
.input:focus{
    border:2px solid rgb(6, 193, 6);
}
.output_area{
    max-width: 500px;
    gap: 12px;
    display: flex;
    flex-direction: column;
    margin: auto;

}
.output_box{
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    background-color: white;
    padding: 12px 18px;
    border-radius: 8px;
    border-left: 14px solid #3498db;
    
}

.output_chick,.output_delete,.output_update{
    
    width: 25px;
    height: 25px;
    text-align: center;
    padding: 2px;
    margin: 2px;
}
.output_chick{
    background-color: greenyellow;
    cursor: pointer;
}
.output_chick:hover{
    background-color: green;
}
.output_update{
    background-color: yellow;
    cursor: pointer;
}
.output_update:hover{
    background-color: rgb(138, 138, 3);
}
.output_delete{
    background-color: bisque;
    cursor: pointer;
}
.output_delete:hover{
    background-color: rgb(156, 87, 2);
}
.output_txt{
    color: black;
    font-family: 'Courier New', Courier, monospace;
}

