body{
    font-family: Arial, Helvetica, sans-serif;
    background-color: #f4f6f6;
    padding: 20px;
}
header{
    text-align: center;
    margin-bottom: 20px;
}
.my_name{
    text-align: center;
    color:#545253;
    font-family: 'Courier New', Courier, monospace;
    font-style: italic;
    font-weight: bolder;
}
.input_field{
    display: flex;
    justify-content: center;
    gap: 10px;
    
}
.input{
    border-radius: 6px;
    width: 300px;
    font-size: 16px;
    border: 2px solid #ccc;
    outline: none;
}
.input:focus{
    border:2px solid rgb(37, 208, 37);
}
.submit,.clear{
    padding: 10px 20px ;
    font-size: 16px;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    
}
.submit{
    background-color: #2ecc71;
    color: white;
}
.clear{
    background-color: rgb(255, 0, 0);
    color: white;
}
.submit:hover{
    background-color: #05652d;
}
.clear:hover{
    background-color: rgb(157, 5, 5);
}
.output_area{
    max-width: 500px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin: auto;
    margin-top: 20px;
}
.output_field{
    display: flex;
    justify-content: space-between;
    align-items: center;
    background-color: white;
    padding: 12px 18px;
    border-radius: 8px;
    border-left: 14px solid #3498db;
}
.output_txt{
    font-size: 16px;
    word-break: break-all;
    max-width: 350px;
    
}
.txt_data{
    color: #2c3e50;
}
.output_icons{
    display: flex;
    gap: 12px;
    align-items: center;
}
.recicle_bin , .update{
    width: 20px;
    height: 20px;
    cursor: pointer;
    opacity: 0.7;
}
.recicle_bin:hover, .update:hover{
    opacity: 1;
}
.theme_toggle:hover{
    opacity: 1;
}
.theme_toggle{
    cursor: pointer;
    background-color: none;
    border: 2px solid #e3ded6;
    border: 50%;
    width: 35px;
    height: 35px;
    display: flex;
    justify-content: center;
    align-items: center;

}
body.dark-mode{
    background-color: #1e222b;
    color: #d1d5db;
}
body.dark-mode .my_name{
    color: #93c5fd;
}
body.dark-mode .theme_toggle {
    border-color: #374151;
    background-color: #262c36;
}
body.dark-mode .input {
    background-color: #262c36;
    color: #f3f4f6;
    border-color: #374151;
}
body.dark-mode .input:focus {
    border-color: #60a5fa;
}
body.dark-mode .submit {
    background-color: #2ea043;
}
body.dark-mode .clear {
    background-color: #da3633;
}
body.dark-mode .output_field {
    background-color: #262c36;
    border-left-color: #60a5fa;
}
body.dark-mode .txt_data {
    color: #f3f4f6;
}
