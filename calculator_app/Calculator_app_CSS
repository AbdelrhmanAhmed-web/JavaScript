.input_area{
    max-width: 300px;
    max-height: 500px;
    background-color: aqua;
    display: grid;
    
    grid-template-columns: repeat(2,auto);
    grid-template-rows: repeat(1,1fr);
    flex-direction: column;
    align-items: flex-start;
    
}

.input_numbers{
    display: flex;
    flex-direction: column;
    align-self: flex-start;
    display: grid;
    grid-template-columns: repeat(3,auto) ;
    grid-template-rows: repeat((3,auto));
    
}
.input_operations{
    display: flex;
    flex-direction: column;
    align-self: flex-start;
}
.input_tail {
    display: flex;
    width: 100%;                    
    grid-column: 1 / -1;           
    flex-direction: row;
    justify-content: space-between; 
}
.plus, .minus , .multiply, .divide{
    height: 46px;
    
}
.zero , .dout , .equal,.enter{
    width: 75px;
    flex-direction: row;
    
}
.one,.two,.three,.four,.five,.six,.seven,.eight,.nine{
    width: 50px;
    height: 63.8px;
}
.input_operations{
    width: 150px;
    height: fit-content;
}
.divide{
    height: 53px;
}
.output_area{
    background-color: aqua;
    width: 300px;
    height: 50px;
}
.output_area{
    display: flex;
    justify-content: space-between;
}
.clear{
    display: flex;
    

}

body {
    display: flex;
    flex-direction: column;
    align-items: center;   
    justify-content: flex-start; 
    padding-top: 50px;     
    min-height: 100vh;
    
    background-color: white;
}

button {
    display: flex;
    justify-content: center;
    align-items: center;
    font-size: 18px; 
    cursor: pointer;
}

.output_area {
    background-color: aqua;
    width: 300px;
    height: 50px;
    display: flex;
    justify-content: space-between;
    align-items: center; 
    padding: 10px;    
    box-sizing: border-box;
    border-radius: 5px;
    margin-bottom: 10px;
}
