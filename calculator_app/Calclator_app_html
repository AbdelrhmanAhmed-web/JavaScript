<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Calculator</title>
    <link rel="stylesheet" href="project_calculator.css">
</head>
<body>
    <header class="calculator"><h1 class="title"> Calculator</h1></header>

    <div class="output_area">
        <div class="output_box">
            <span class="num1"></span>
            <span class="operator"></span>
            <span class="num2"></span>
        </div>
        <div class="output_clear"><button class="clear">clear</button></div>
    </div>
    <div class="input_area">
        <div class="input_numbers">
            <button class="seven">7</button>
            <button class="eight">8</button>
            <button class="nine">9</button>
            <button class="four">4</button>
            <button class="five">5</button>
            <button class="six">6</button>
            <button class="one">1</button>
            <button class="two">2</button>
            <button class="three">3</button>
        </div>
        <div class="input_operations">
            <button class="plus">+</button>
            <button class="minus">-</button>
            <button class="multiply">*</button>
            <button class="divide">÷</button>
        </div>
        <div class="input_tail">
            <button class="zero">0</button>
            <button class="dout">.</button>
            <button class="equal">=</button>
            <button class="enter">enter</button>
        </div>
    </div>
</body>
<script src="project_calculator.js"></script>
</html>
