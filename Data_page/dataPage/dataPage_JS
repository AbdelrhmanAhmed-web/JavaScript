function resetScreen(){
    output_user_header.style.display = 'none'
    output_product_header.style.display = 'none'
    users_arr.forEach(user => {
        user.style.display = 'none'
    })
    products_arr.forEach(product => {
        product.style.display = 'none'
    })
    let active = document.querySelectorAll('.form_user, .form_product, .submit_user, .submit_product, .br_line, .br_line1')
    active.forEach(elment => {
        elment.style.display = 'none'
    })
    back.style.display = 'none'
}

add_user.addEventListener('click', () => {
    resetScreen()
    
    let br_line = document.createElement('hr')
    br_line.className = 'br_line'
    document.body.appendChild(br_line)

    let form_user = document.createElement('form')
    form_user.className = 'form_user'

    let field_user = document.createElement('div')
    field_user.className = 'field_user'

    let label_name = document.createElement('label')
    label_name.textContent = 'Name:'
    let input_name = document.createElement('input')
    input_name.id = 'input_name'
    field_user.appendChild(label_name)
    field_user.appendChild(input_name)

    let label_age = document.createElement('label')
    label_age.textContent = 'Age:'
    let input_age = document.createElement('input')
    input_age.id = 'input_age'
    field_user.appendChild(label_age)
    field_user.appendChild(input_age)

    let label_city = document.createElement('label')
    label_city.textContent = 'City:'
    let input_city = document.createElement('input')
    input_city.id = 'input_city'
    field_user.appendChild(label_city)
    field_user.appendChild(input_city)

    let label_country = document.createElement('label')
    label_country.textContent = 'Country:'
    let input_country = document.createElement('input')
    input_country.id = 'input_country'
    field_user.appendChild(label_country)
    field_user.appendChild(input_country)

    let label_phone = document.createElement('label')
    label_phone.textContent = 'Phone:'
    let input_phone = document.createElement('input')
    input_phone.id = 'input_phone'
    field_user.appendChild(label_phone)
    field_user.appendChild(input_phone)

    form_user.appendChild(field_user)
    document.body.appendChild(form_user)

    back.addEventListener('click', () => {
        form_user.style.display = 'none'
        submit_user.style.display = 'none'
        back.style.display = 'none'
        br_line.style.display = 'none'
    })

    let submit_user = document.createElement('button')
    submit_user.textContent = 'Save'
    submit_user.className = 'submit_user'
    form_user.appendChild(submit_user)
    document.body.appendChild(submit_user)
    back.style.display = ''
    document.body.appendChild(back)

    submit_user.addEventListener('click', (e) => {
        e.preventDefault()

        if(input_name.value.trim() === '' || input_age.value.trim() === '' || input_city.value.trim() === '' || input_country.value.trim() === '' || input_phone.value.trim() === ''){
            alert('Data not compleated..')
            return
        }
        if(isNaN(input_age.value) || input_age.value <= 0){
            alert('age not accurate, please enter valid value..')
            return
        }
        if(isNaN(input_phone.value) || input_phone.value.length != 9){
            alert('phone number is not in a correct format, please try again..')
            return
        }

        let output_users = document.createElement('div')
        output_users.className = 'output_users'

        let name_val = document.createElement('p')
        name_val.className = 'name_val'
        name_val.textContent = input_name.value

        let age_val = document.createElement('p')
        age_val.className = 'age_val'
        age_val.textContent = input_age.value

        let city_val = document.createElement('p')
        city_val.className = 'city_val'
        city_val.textContent = input_city.value

        let country_val = document.createElement('p')
        country_val.className = 'country_val'
        country_val.textContent = input_country.value

        let phone_val = document.createElement('p')
        phone_val.className = 'phone_val'
        phone_val.textContent = input_phone.value

        let action_div = document.createElement('div')
        action_div.className = 'action_buttons'

        let delete_user = document.createElement('button')
        delete_user.className = 'delete_user'
        delete_user.textContent = '🗑️'

        let edit_user = document.createElement('button')
        edit_user.className = 'edit_user'
        edit_user.textContent = '✏️'

        delete_user.addEventListener('click', () => {
            document.body.removeChild(output_users)
            users_arr.splice(users_arr.indexOf(output_users), 1)
        })

        edit_user.addEventListener('click', () => {
            let parts = output_users.querySelectorAll('.name_val, .age_val, .city_val, .country_val, .phone_val')
            if(edit_user.textContent === '✏️'){
                parts.forEach((part) => {
                    let input1 = document.createElement('input')
                    input1.type = 'text'
                    input1.className = part.className
                    input1.value = part.textContent
                    part.replaceWith(input1)
                })
                edit_user.textContent = '💾'
            } else {
                let inputs = output_users.querySelectorAll('input')
                inputs.forEach((input) => {
                    let p = document.createElement('p')
                    p.className = input.className
                    p.textContent = input.value
                    input.replaceWith(p)
                })
                edit_user.textContent = '✏️'
            }
        })

        action_div.appendChild(delete_user)
        action_div.appendChild(edit_user)

        output_users.appendChild(name_val)
        output_users.appendChild(age_val)
        output_users.appendChild(city_val)
        output_users.appendChild(country_val)
        output_users.appendChild(phone_val)
        output_users.appendChild(action_div)

        users_arr.push(output_users)

        back.style.display = ''
        document.body.appendChild(back)
        back.addEventListener('click', () => {
            form_user.style.display = 'none'
            submit_user.style.display = 'none'
            back.style.display = 'none'
            br_line.style.display = 'none'
        })
        input_name.value = ''
        input_age.value = ''
        input_city.value = ''
        input_country.value = ''
        input_phone.value = ''
    })
})

users.addEventListener('click', () => {
    resetScreen()
    output_user_header.style.display = ''

    users_arr.forEach((user) => {
        if(!user.parentNode) document.body.appendChild(user)
        user.style.display = ''
    })
})

add_product.addEventListener('click', () => {
    resetScreen()
    back.style.display = ''

    let br_line1 = document.createElement('hr')
    br_line1.className = 'br_line1'
    document.body.appendChild(br_line1)

    let form_product = document.createElement('form')
    form_product.className = 'form_product'

    let field_product = document.createElement('div')
    field_product.className = 'field_product'

    let label_p_name = document.createElement('label')
    label_p_name.textContent = 'Product Name:'
    let input_p_name = document.createElement('input')
    input_p_name.id = 'input_p_name'
    field_product.appendChild(label_p_name)
    field_product.appendChild(input_p_name)

    let label_p_price = document.createElement('label')
    label_p_price.textContent = 'Product Price:'
    let input_p_price = document.createElement('input')
    input_p_price.id = 'input_p_price'
    field_product.appendChild(label_p_price)
    field_product.appendChild(input_p_price)

    let label_p_stock = document.createElement('label')
    label_p_stock.textContent = 'In Stock:'
    let input_p_stock = document.createElement('input')
    input_p_stock.id = 'input_p_stock'
    field_product.appendChild(label_p_stock)
    field_product.appendChild(input_p_stock)

    let label_p_discrip = document.createElement('label')
    label_p_discrip.textContent = 'Product Discription:'
    let input_p_discription = document.createElement('input')
    input_p_discription.id = 'input_p_discription'
    field_product.appendChild(label_p_discrip)
    field_product.appendChild(input_p_discription)

    form_product.appendChild(field_product)
    document.body.appendChild(form_product)

    let submit_product = document.createElement('button')
    submit_product.className = 'submit_product'
    submit_product.textContent = 'Save'
    document.body.appendChild(submit_product)
    document.body.appendChild(back)

    back.addEventListener('click', () => {
        form_product.style.display = 'none'
        br_line1.style.display = 'none'
        submit_product.style.display = 'none'
        back.style.display = 'none'
    })

    submit_product.addEventListener('click', (e) => {
        e.preventDefault()
        if(input_p_name.value === '' || input_p_price.value === '' || input_p_stock.value === '' || input_p_discription.value === ''){
            alert('Data not compleated')
            return
        }
        if(isNaN(input_p_price.value) || input_p_price.value < 0){
            alert('Price not accurate..')
            return
        }
        if(isNaN(input_p_stock.value)){
            alert('Stock quantity shoud be number')
            return
        }

        let output_products = document.createElement('div')
        output_products.className = 'output_products'

        let name_val = document.createElement('p')
        name_val.className = 'name_val'
        name_val.textContent = input_p_name.value

        let price_val = document.createElement('p')
        price_val.className = 'price_val'
        price_val.textContent = `${input_p_price.value} $`

        let stock_val = document.createElement('p')
        stock_val.className = 'stock_val'
        stock_val.textContent = input_p_stock.value

        let discip_val = document.createElement('p')
        discip_val.className = 'discip_val'
        discip_val.textContent = input_p_discription.value

        let product_action_div = document.createElement('div')
        product_action_div.className = 'action_buttons'

        let delete_product = document.createElement('button')
        delete_product.className = 'delete_user'
        delete_product.textContent = '🗑️'

        let edit_product = document.createElement('button')
        edit_product.className = 'edit_user'
        edit_product.textContent = '✏️'

        delete_product.addEventListener('click', () => {
            document.body.removeChild(output_products)
            products_arr.splice(products_arr.indexOf(output_products), 1)
        })

        edit_product.addEventListener('click', () => {
            let product_parts = output_products.querySelectorAll('.name_val, .price_val, .stock_val, .discip_val')
            if(edit_product.textContent === '✏️'){
                product_parts.forEach((part) => {
                    let input_p1 = document.createElement('input')
                    input_p1.type = 'text'
                    input_p1.className = part.className
                    input_p1.value = part.textContent.replace(' $', '')
                    part.replaceWith(input_p1)
                })
                edit_product.textContent = '💾'
            } else {
                let product_inputs = output_products.querySelectorAll('input')
                product_inputs.forEach((input) => {
                    let p = document.createElement('p')
                    p.className = input.className
                    if(input.className === 'price_val'){
                        p.textContent = `${input.value} $`
                    } else {
                        p.textContent = input.value
                    }
                    input.replaceWith(p)
                })
                edit_product.textContent = '✏️'
            }
        })

        product_action_div.appendChild(delete_product)
        product_action_div.appendChild(edit_product)

        output_products.appendChild(name_val)
        output_products.appendChild(price_val)
        output_products.appendChild(stock_val)
        output_products.appendChild(discip_val)
        output_products.appendChild(product_action_div)

        products_arr.push(output_products)

        back.style.display = ''
        back.addEventListener('click', () => {
            form_product.style.display = 'none'
            br_line1.style.display = 'none'
            submit_product.style.display = 'none'
            back.style.display = 'none'
        })
        input_p_name.value = ''
        input_p_price.value = ''
        input_p_stock.value = ''
        input_p_discription.value = ''
    })
})

products.addEventListener('click', () => {
    resetScreen()
    output_product_header.style.display = ''
    products_arr.forEach((product) => {
        if(!product.parentNode) document.body.appendChild(product)
        product.style.display = ''
    })
})
