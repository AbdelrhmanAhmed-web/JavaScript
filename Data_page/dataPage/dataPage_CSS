.content{
    display: flex;
    justify-content: flex-end;
    
}
.users,.products{
    width:150px;
    text-align: center;
    background-color: aqua;
    border-radius: 5px;
    cursor: pointer;
    
    
}

.users:hover,.products:hover{
    background-color: rgb(0, 182, 182);
}

.welcome{
    text-align: center;
    font-size: 25px;
    font-weight: bolder;
    font-style: italic;
    background-color: blueviolet;
    color: white;
    display: flex;
    justify-content: center;
    align-items: center;
}

body{
    background-color: rgb(28, 61, 61);
    padding: 10px;
}
