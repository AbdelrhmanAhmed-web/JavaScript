.content{
    display: flex;
    justify-content: space-between;
    
}
.users,.products{
    background-color: #00bcd4;
    color: rgb(28, 61, 61);
    border: none;
    padding: 8px 18px;
    border-radius: 6px;
    cursor: pointer;
    font-weight: bold;
    margin: 10px 0;
    transition: all 0.3s ease;
    width: 150px;
    
    
}

.users:hover,.products:hover{
    background-color: rgb(2, 134, 134);
}

.welcome{
    text-align: center;
    font-size: 25px;
    font-weight: bolder;
    font-style: italic;
    background-color: blueviolet;
    color: white;
    display: flex;
    justify-content: center;
    align-items: center;
}

body{
    background-color: rgb(28, 61, 61);
    padding: 10px;
}

.add_user, .add_product {
    background-color: #00bcd4;
    color: rgb(28, 61, 61);
    border: none;
    padding: 8px 18px;
    border-radius: 6px;
    cursor: pointer;
    font-weight: bold;
    margin: 10px 0;
    transition: all 0.3s ease;
}
.add_user:hover , .add_product:hover{
    background-color: rgb(2, 134, 134);
}

.field_user, .field_product {
    color: white;
    display: grid;
    grid-template-columns: 140px 1fr; 
    align-items: center; 
    gap: 12px;
    width: 520px; 
    background: rgba(0, 0, 0, 0.3); 
    padding: 25px;
    border-radius: 12px;
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.4);
    margin: 0 auto; 
}

.field_user input, .field_product input {
    width: 100%;
    padding: 10px;
    border-radius: 6px;
    border: none;
    outline: none;
    background-color: #ecf0f1;
    font-size: 14px;
    box-sizing: border-box; 
}


.output_user_header, .output_users {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 15px;
    background-color: rgba(0, 0, 0, 0.25);
    padding: 12px 20px;
    margin: 10px 0;
    border-radius: 8px;
    color: white;
    align-items: center;
    
}

.output_user_header {
    display: flex;
    background-color: rgb(130, 12, 240);
    font-weight: bold;
    font-family: 'Courier New', Courier, monospace;
    font-style: italic;
    justify-content: space-between;
}
.output_users{
    display: flex;
    justify-content: space-between;
}





.output_product_header,.output_products{
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    justify-content: space-between;
    background-color: rgba(0, 0, 0, 0.25);
    padding: 12px 20px;
    margin: 10px 0;
    border-radius: 8px;
    color: white;
    align-items: center;
}

.output_product_header{
    display: flex;
    background-color: rgb(130, 12, 240);
    font-weight: bold;
    font-family: 'Courier New', Courier, monospace;
    font-style: italic;
}

.output_products{
    display: flex;
    justify-content: space-between;
}

.back {
    display: flex;
    background-color: #95a5a6; 
    color: white;
    border: none;
    padding: 10px 20px;
    border-radius: 6px;
    cursor: pointer;
    font-weight: bold;
    font-size: 14px;
    margin-top: 10px;
    margin-left: 0px;
    transition: all 0.3s ease;
    box-shadow: 0 4px 6px rgba(0,0,0,0.2);
    justify-self: center;
    width: 250px;
    justify-content: center;
}

.back:hover {
    background-color: #7f8c8d;
    transform: translateY(-2px);
    box-shadow: 0 6px 12px rgba(149, 165, 166, 0.4);
}

.submit_user, .submit_product {
    display: flex;
    background-color: #2ecc71;
    color: white;
    border: none;
    padding: 10px 20px;
    border-radius: 6px;
    cursor: pointer;
    font-weight: bold;
    font-size: 14px;
    margin-top: 10px;
    transition: all 0.3s ease;
    box-shadow: 0 4px 6px rgba(0,0,0,0.2);
    justify-self: center;
    width: 250px;
    justify-content: center;
}


.submit_user:hover, .submit_product:hover {
    background-color: #27ae60;
    transform: translateY(-2px);
    box-shadow: 0 6px 12px rgba(46, 204, 113, 0.4);
}
.field_user input:focus, .field_product input:focus {
    border-color: #00bcd4;
    background-color: #fff;
    box-shadow: 0 0 8px rgba(0, 188, 212, 0.6);
}

.form_user, .form_product {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    margin-top: 20px;
}
.submit_product{
    text-align: center;
}

.action{
    display: flex;
    justify-content: flex-end;
}
