.content{
    display: flex;
    justify-content: flex-end;
    
}
.users,.products{
    width:150px;
    text-align: center;
    background-color: aqua;
    border-radius: 5px;
    cursor: pointer;
    
    
}

.users:hover,.products:hover{
    background-color: rgb(0, 182, 182);
}

.welcome{
    text-align: center;
    font-size: 25px;
    font-weight: bolder;
    font-style: italic;
    background-color: blueviolet;
    color: white;
    display: flex;
    justify-content: center;
    align-items: center;
}

body{
    background-color: rgb(28, 61, 61);
    padding: 10px;
}


.input_name , .input_age, .input_city, .input_country, .input_phone{
    
}
.label_name , .label_age, .label_city, .label_country, .label_phone{
    
}

.field_users{
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    color: white;
}

.field_products{
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    color: white;
}
.product_output_field{
    color: white;
}
.users_output_field{
    color: white;
}


.add_user, .add_product, .submit_users, .submit_product, .back {
    background-color: #00bcd4;
    color: rgb(28, 61, 61);
    border: none;
    padding: 8px 18px;
    border-radius: 6px;
    cursor: pointer;
    font-weight: bold;
    margin: 10px 0;
    transition: all 0.3s ease;
}
