let products = window.localStorage.getItem('Purchesd')
let products_chk ;

if(products){
    products_chk=JSON.parse(products)
}
else{
    products_chk=[]
}

let products_stock = window.localStorage.getItem('Saved products') 
let stock_item;
if(products_stock){
    stock_item= JSON.parse(products_stock)
}
else{
    stock_item=[]
}

let total_amount =0

products_chk.forEach((product) => {
    let product_card = document.createElement('div')
    product_card.className='product_card'
    product_card.innerHTML=`
        <h3 class='p_name'> Product Name: ${product.name}</h3>
        <h3 class='p_price'> Product Price: ${product.Price} $</h3>
    `
    document.body.appendChild(product_card)
    let hr = document.createElement('hr')
    document.body.appendChild(hr)
    total_amount+= parseFloat(product.Price) || 0 
});

let total = document.createElement('h2')
total.className='total_price'
total.textContent=`Total amount: ${total_amount}$`
document.body.appendChild(total)

let checkout_btn = document.createElement('button')
checkout_btn.textContent='Do You want to check out? '
document.body.appendChild(checkout_btn)


checkout_btn.addEventListener('click',()=>{
    if(products_chk.length===0){
        alert('the cart is empty..')
        return;
    }

    products_chk.forEach((bought_product)=>{
        let matching_items = stock_item.find(item=>item.Product_name===bought_product.name)
        if(matching_items){
            let currentStock = parseInt(matching_items.Stock) || 0
            if (currentStock > 0) {
                matching_items.Stock = (currentStock - 1).toString()
            }   
        }
    })
    window.localStorage.setItem('Saved products', JSON.stringify(stock_item))
    window.localStorage.removeItem('Purchesd')
    alert('Thank you for your purchase!')

window.location.reload()
})

