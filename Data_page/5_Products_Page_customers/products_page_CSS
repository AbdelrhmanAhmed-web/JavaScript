body {
    background-color: #242424;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    margin: 0;
    padding-bottom: 50px;
}


.header {
    background: linear-gradient(135deg, #01252f, #0072ff);
    color: white;
    text-align: center;
    position: sticky;
    top:0;
    z-index: 1000;
    padding: 22px;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
}

.website_title {
    color: #ffffff;
    font-family: 'Courier New', Courier, monospace;
    font-size: 26px;
    font-weight: bold;
    letter-spacing: 1px;
    margin: 0;
    text-shadow: 1px 1px 3px rgba(0,0,0,0.2);
}


.cart {
    background-color: #28a745;
    color: white;
    cursor: pointer;
    position: absolute;          
    right: 25px;                 
    top: 50%;                    
    transform: translateY(-50%); 
    border: none;
    padding: 10px 18px;
    border-radius: 30px;
    font-size: 15px;
    font-weight: bold;
    box-shadow: 0 4px 12px rgba(40, 167, 69, 0.4);
    transition: all 0.3s ease;
}

.cart:hover {
    background-color: #218838;
    transform: translateY(-50%) scale(1.05);
}


.product_card {
    display: flex;
    justify-content: space-between;
    align-items: center; 
    width: 75%;           
    margin: 25px auto;   
    padding: 25px;
    background: #ffffff;
    border: none; 
    border-radius: 12px;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.06);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.product_card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.1);
}

.p_info {
    flex: 1;
    padding-right: 20px;
}

.p_name {
    color: #2c3e50;
    font-size: 20px;
    font-weight: bold;
    margin-bottom: 8px;
}

.p_price {
    color: #e74c3c;
    font-size: 17px;
    font-weight: bold;
    margin-bottom: 8px;
}

.p_discrip {
    color: #7f8c8d;
    font-size: 14px;
    margin-bottom: 15px;
}

.img_product {
    display: flex;
    gap: 12px;         
    align-items: center;
    flex-wrap: wrap;
}

.imgs {
    width: 140px;
    height: 110px;
    object-fit: cover;   
    border-radius: 8px; 
    border: 1px solid #eaeaea;
    transition: transform 0.3s ease;
}

.imgs:hover {
    transform: scale(1.04);
}

.buy {
    margin-top: 10px;
    padding: 10px 22px;
    background: linear-gradient(135deg, #007bff, #0056b3);
    color: white;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    font-weight: bold;
    box-shadow: 0 4px 10px rgba(0, 123, 255, 0.3);
    transition: all 0.2s ease;
}

.buy:hover {
    background: linear-gradient(135deg, #0056b3, #004085);
    box-shadow: 0 6px 15px rgba(0, 123, 255, 0.5);
    transform: translateY(-2px);
}

.buy:active {
    transform: translateY(0);
}

@keyframes cartFlash {
    0% {
        transform: translateY(-50%) scale(1);
        box-shadow: 0 0 0 0 rgba(40, 167, 69, 0.7);
    }
    50% {
        transform: translateY(-50%) scale(1.25); 
        background-color: #ffc107;   
        color: #000;
        box-shadow: 0 0 20px 8px rgba(255, 193, 7, 0.8);
    }
    100% {
        transform: translateY(-50%) scale(1);
        box-shadow: 0 0 0 0 rgba(40, 167, 69, 0);
    }
}

.cart-anim {
    animation: cartFlash 0.4s ease;
}
